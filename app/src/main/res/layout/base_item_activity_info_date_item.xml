<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.twinlife.twinme.utils.CircularImageView
            android:id="@+id/base_item_activity_info_date_item_avatar_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/base_item_activity_info_date_item_name_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/base_item_activity_info_date_item_avatar_view"
            app:layout_constraintEnd_toStartOf="@id/base_item_activity_info_date_item_date_text_view"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/base_item_activity_info_date_item_date_text_view"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:textAlignment="gravity"
            android:gravity="center_vertical|end"
            android:textColor="?attr/font_default_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/base_item_activity_info_date_item_separator" />

        <View
            android:id="@+id/base_item_activity_info_date_item_separator"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:background="?attr/separator_color"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>