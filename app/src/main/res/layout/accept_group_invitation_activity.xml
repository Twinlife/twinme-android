<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <View
        android:id="@+id/accept_group_invitation_activity_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="visible" />

    <RelativeLayout
        android:id="@+id/accept_group_invitation_activity_action_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true">

        <View
            android:id="@+id/accept_group_invitation_activity_slide_mark_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true" />

        <RelativeLayout
            android:id="@+id/accept_group_invitation_activity_identity_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/accept_group_invitation_activity_slide_mark_view">

            <RelativeLayout
                android:id="@+id/accept_group_invitation_activity_identity_avatar_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/accept_group_invitation_activity_identity_left_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/accept_group_invitation_activity_left_avatar_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:elevation="8dp"
                        android:padding="3dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="@android:color/white"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        android:layout_centerHorizontal="true"/>

                    <RelativeLayout
                        android:id="@+id/accept_group_invitation_activity_left_line_container_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/accept_group_invitation_activity_left_avatar_view">

                        <View
                            android:id="@+id/accept_group_invitation_activity_left_line_view"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_centerInParent="true"/>

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/accept_group_invitation_activity_left_name_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_below="@+id/accept_group_invitation_activity_left_avatar_view" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/accept_group_invitation_activity_identity_right_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/accept_group_invitation_activity_right_avatar_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:elevation="8dp"
                        android:padding="3dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="@android:color/white"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        android:layout_centerHorizontal="true" />

                    <RelativeLayout
                        android:id="@+id/accept_group_invitation_activity_right_line_container_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/accept_group_invitation_activity_right_avatar_view">

                        <View
                            android:id="@+id/accept_group_invitation_activity_right_line_view"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_centerInParent="true"/>

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/accept_group_invitation_activity_right_name_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/accept_group_invitation_activity_right_avatar_view"
                        android:gravity="center" />

                    <View
                        android:id="@+id/accept_group_invitation_activity_bullet_view"
                        android:layout_alignEnd="@+id/accept_group_invitation_activity_right_avatar_view"
                        android:layout_alignTop="@+id/accept_group_invitation_activity_right_avatar_view"
                        android:elevation="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/accept_group_invitation_activity_contact_avatar_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:elevation="8dp"
                        android:layout_alignTop="@+id/accept_group_invitation_activity_right_avatar_view"
                        android:layout_toEndOf="@+id/accept_group_invitation_activity_bullet_view"
                        android:padding="3dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="@android:color/white"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/accept_group_invitation_activity_identity_middle_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">

                    <RelativeLayout
                        android:id="@+id/accept_group_invitation_activity_icon_group_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:elevation="8dp"
                        android:layout_centerInParent="true">

                        <ImageView
                            android:id="@+id/accept_group_invitation_activity_icon_group_image_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/groups_icon"/>

                        <ImageView
                            android:id="@+id/accept_group_invitation_activity_status_image_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/invitation_state_accepted" />

                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>

        </RelativeLayout>

        <TextView
            android:id="@+id/accept_group_invitation_activity_message_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/accept_group_invitation_activity_identity_view"
            android:gravity="center"
            android:text="@string/fullscreen_qrcode_view_generate_code_message" />

        <RelativeLayout
            android:id="@+id/accept_group_invitation_activity_confirm_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/accept_group_invitation_activity_message_view">

            <TextView
                android:id="@+id/accept_group_invitation_activity_confirm_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="@string/application_accept" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/accept_group_invitation_activity_cancel_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/accept_group_invitation_activity_confirm_view">

            <TextView
                android:id="@+id/accept_group_invitation_activity_cancel_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/application_decline" />
        </RelativeLayout>

    </RelativeLayout>

    <ProgressBar
        android:id="@+id/accept_group_invitation_activity_progress_bar"
        style="@android:style/Widget.ProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>