<?xml version="1.0" encoding="utf-8"?>
<androidx.percentlayout.widget.PercentRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/show_external_call_activity_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/show_external_call_activity_avatar_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true" />

    <ScrollView
        android:id="@+id/show_external_call_activity_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.percentlayout.widget.PercentRelativeLayout
            android:id="@+id/show_external_call_activity_content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/show_contact_content">

            <View
                android:id="@+id/show_external_call_activity_slide_mark_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true" />

            <androidx.percentlayout.widget.PercentRelativeLayout
                android:id="@+id/show_external_call_activity_content_header_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/show_external_call_activity_title_view"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:lines="1"
                    android:text="@string/premium_services_view_click_to_call_title"
                    app:layout_widthPercent="66.67%" />

                <androidx.percentlayout.widget.PercentRelativeLayout
                    android:id="@+id/show_external_call_activity_edit_clickable_view"
                    app:layout_widthPercent="19.73%"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="@string/application_edit">

                    <ImageView
                        android:id="@+id/show_external_call_activity_edit_image_view"
                        android:layout_centerInParent="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/action_edit"
                        app:layout_aspectRatio="100%"
                        app:layout_heightPercent="40%" />
                </androidx.percentlayout.widget.PercentRelativeLayout>

            </androidx.percentlayout.widget.PercentRelativeLayout>

            <TextView
                android:id="@+id/show_external_call_activity_description_text_view"
                android:layout_below="@+id/show_external_call_activity_content_header_view"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                app:layout_widthPercent="90.93%" />

            <androidx.percentlayout.widget.PercentRelativeLayout
                android:id="@+id/show_external_call_activity_action_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/show_external_call_activity_description_text_view">

                <androidx.percentlayout.widget.PercentRelativeLayout
                    android:id="@+id/show_external_call_activity_share_clickable_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@+id/show_external_call_activity_audio_clickable_view">

                    <androidx.percentlayout.widget.PercentRelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <org.twinlife.twinme.utils.RoundedView
                            android:id="@+id/show_external_call_activity_share_rounded_view"
                            android:layout_width="match_parent"
                            app:layout_aspectRatio="100%"
                            app:layout_widthPercent="100%" />

                        <ImageView
                            android:id="@+id/show_external_call_activity_share_view"
                            android:scaleType="fitCenter"
                            android:src="@drawable/qrcode"
                            android:layout_centerInParent="true"
                            app:layout_aspectRatio="100%"
                            app:layout_widthPercent="34.37%" />
                    </androidx.percentlayout.widget.PercentRelativeLayout>

                    <TextView
                        android:id="@+id/show_external_call_activity_share_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:text="@string/share_view_title" />
                </androidx.percentlayout.widget.PercentRelativeLayout>

                <androidx.percentlayout.widget.PercentRelativeLayout
                    android:id="@+id/show_external_call_activity_audio_clickable_view"
                    android:layout_centerHorizontal="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.percentlayout.widget.PercentRelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <org.twinlife.twinme.utils.RoundedView
                            android:id="@+id/show_external_call_activity_audio_rounded_view"
                            android:layout_width="match_parent"
                            app:layout_aspectRatio="100%"
                            app:layout_widthPercent="100%" />

                        <ImageView
                            android:id="@+id/show_external_call_activity_audio_view"
                            android:scaleType="fitCenter"
                            android:src="@drawable/audio_call"
                            android:layout_centerInParent="true"
                            app:layout_aspectRatio="100%"
                            app:layout_widthPercent="34.37%" />
                    </androidx.percentlayout.widget.PercentRelativeLayout>

                    <TextView
                        android:id="@+id/show_external_call_activity_audio_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:text="@string/show_contact_view_audio" />
                </androidx.percentlayout.widget.PercentRelativeLayout>

                <androidx.percentlayout.widget.PercentRelativeLayout
                    android:id="@+id/show_external_call_activity_video_clickable_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@+id/show_external_call_activity_audio_clickable_view">

                    <androidx.percentlayout.widget.PercentRelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <org.twinlife.twinme.utils.RoundedView
                            android:id="@+id/show_external_call_activity_video_rounded_view"
                            android:layout_width="match_parent"
                            app:layout_aspectRatio="100%"
                            app:layout_widthPercent="100%" />

                        <ImageView
                            android:id="@+id/show_external_call_activity_video_view"
                            android:scaleType="fitCenter"
                            android:src="@drawable/video_call"
                            android:layout_centerInParent="true"
                            app:layout_aspectRatio="157.14%"
                            app:layout_widthPercent="34.37%" />
                    </androidx.percentlayout.widget.PercentRelativeLayout>

                    <TextView
                        android:id="@+id/show_external_call_activity_video_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:text="@string/show_contact_view_video" />
                </androidx.percentlayout.widget.PercentRelativeLayout>

            </androidx.percentlayout.widget.PercentRelativeLayout>

            <TextView
                android:id="@+id/show_external_call_activity_identity_title_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/show_external_call_activity_action_view"
                android:text="@string/show_call_view_meeting_organizer"
                android:textAllCaps="true"
                android:maxLines="1"
                app:layout_marginEndPercent="4%"
                app:layout_marginStartPercent="4%" />

            <androidx.percentlayout.widget.PercentRelativeLayout
                android:id="@+id/show_external_call_activity_identity_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/item_light_border"
                android:layout_below="@+id/show_external_call_activity_identity_title_view">

                <ImageView
                    android:id="@+id/show_contact_activity_identity_image_view"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:src="@drawable/knows_me_as_icon"
                    app:layout_aspectRatio="100%"
                    app:layout_heightPercent="31.67%"
                    app:layout_marginStartPercent="4.53%" />

                <TextView
                    android:id="@+id/show_external_call_activity_identity_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    app:layout_marginStartPercent="12.8%"
                    app:layout_marginEndPercent="3.73%" />

                <org.twinlife.twinme.utils.CircularImageView
                    android:id="@+id/show_external_call_activity_identity_avatar_view"
                    android:scaleType="fitCenter"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:layout_aspectRatio="100%"
                    app:layout_heightPercent="56.67%"
                    app:layout_marginRightPercent="4%"
                    app:layout_marginEndPercent="4%" />

            </androidx.percentlayout.widget.PercentRelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/show_external_call_activity_settings_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/show_external_call_activity_identity_view" />

            <TextView
                android:id="@+id/show_external_call_activity_last_calls_title_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/show_external_call_activity_settings_view"
                android:text="@string/show_contact_view_history_title"
                android:textAllCaps="true"
                android:maxLines="1"
                app:layout_widthPercent="53.33%"
                app:layout_marginEndPercent="4%"
                app:layout_marginStartPercent="4%" />

            <androidx.percentlayout.widget.PercentRelativeLayout
                android:id="@+id/show_external_call_activity_last_calls_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/show_external_call_activity_last_calls_title_view"
                android:background="@drawable/item_light_border">

                <ImageView
                    android:id="@+id/show_external_call_activity_last_calls_image_view"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:src="@drawable/last_audio_call"
                    app:layout_aspectRatio="100%"
                    app:layout_heightPercent="31.67%"
                    app:layout_marginStartPercent="4.53%" />

                <TextView
                    android:id="@+id/show_external_call_activity_last_calls_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/show_contact_view_last_calls"
                    app:layout_marginEndPercent="4.27%"
                    app:layout_marginStartPercent="12.8%" />

                <ImageView
                    android:id="@+id/show_external_call_activity_last_calls_accessory_view"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/end_chevron"
                    app:tint="@color/accessory_color"
                    app:layout_aspectRatio="54.55%"
                    app:layout_heightPercent="25%"
                    app:layout_marginEndPercent="5.33%" />
            </androidx.percentlayout.widget.PercentRelativeLayout>

        </androidx.percentlayout.widget.PercentRelativeLayout>

    </ScrollView>

    <androidx.percentlayout.widget.PercentRelativeLayout
        android:id="@+id/show_external_call_activity_back_clickable_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:orientation="horizontal"
        app:layout_aspectRatio="100%">

        <org.twinlife.twinme.utils.RoundedView
            android:id="@+id/show_external_call_activity_back_rounded_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/show_external_call_activity_back_image_view"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter"
            android:src="@drawable/start_chevron"
            app:layout_aspectRatio="62.5%"
            app:layout_heightPercent="37.5%" />

    </androidx.percentlayout.widget.PercentRelativeLayout>

    <View
        android:id="@+id/show_external_call_activity_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="invisible" />

    <org.twinlife.twinme.ui.externalCallActivity.MenuCallCapabilitiesView
        android:id="@+id/show_external_call_activity_menu_call_capabilities_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/show_external_call_activity_progress_bar"
        style="@android:style/Widget.ProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</androidx.percentlayout.widget.PercentRelativeLayout>