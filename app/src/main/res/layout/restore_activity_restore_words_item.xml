<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/restore_activity_words_item_message_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="@string/restore_view_enter_words" />

    <RelativeLayout
        android:id="@+id/restore_activity_words_item_container_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/restore_activity_words_item_message_view"
        android:layout_centerHorizontal="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:id="@+id/restore_activity_words_item_position_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"/>

        <org.twinlife.twinme.ui.contacts.PasteEditText
            android:id="@+id/restore_activity_words_item_edit_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/restore_activity_words_item_position_view"
            android:background="@android:color/transparent"
            android:hint="@string/application_search_hint"
            android:textAllCaps="true"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions" />

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/restore_activity_words_item_list_view"
        android:layout_below="@+id/restore_activity_words_item_container_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <org.twinlife.twinme.ui.backupActivity.WordCompletionView
        android:id="@+id/restore_activity_words_item_word_completion_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/restore_activity_words_item_container_view"/>

    <RelativeLayout
        android:id="@+id/restore_activity_words_item_paste_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/restore_activity_words_item_list_view">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true">

            <ImageView
                android:id="@+id/restore_activity_words_item_paste_image_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/paste_icon"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/restore_activity_words_item_paste_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/restore_activity_words_item_paste_image_view"
                android:text="@string/restore_view_paste" />

        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>