<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="128dp">

    <TextView
        android:id="@+id/section_title_item_title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="@string/contacts_view_title"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/section_title_item_badge_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_alignBottom="@+id/section_title_item_title_view"
        android:layout_toEndOf="@+id/section_title_item_title_view"
        android:text="@string/application_new" />

    <View
        android:id="@+id/section_title_item_item_separator_view"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/separator_color"
        android:layout_alignParentBottom="true" />

</RelativeLayout>