<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:background="?attr/white_color">

    <RelativeLayout
        android:id="@+id/last_calls_activity_item_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <RelativeLayout
            android:id="@+id/last_calls_activity_item_information_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">

            <RelativeLayout
                android:id="@+id/last_calls_activity_item_header_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/last_calls_activity_item_type_image_view"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/history_audio_call" />

                <TextView
                    android:id="@+id/last_calls_activity_item_type_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/last_calls_activity_item_type_image_view"
                    android:ellipsize="end"
                    android:lines="1" />
            </RelativeLayout>

            <TextView
                android:id="@+id/last_calls_activity_item_duration_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:layout_below="@+id/last_calls_activity_item_header_view"/>

        </RelativeLayout>

        <TextView
            android:id="@+id/last_calls_activity_item_date_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="end"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:ellipsize="end" />

        <View
            android:id="@+id/last_calls_activity_item_separator_view"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="?attr/separator_color"
            android:layout_alignStart="@+id/last_calls_activity_item_information_view"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>

</RelativeLayout>