<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="252dp">

    <RelativeLayout
        android:id="@+id/conversation_files_activity_media_item_container_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">

        <ImageView
            android:id="@+id/conversation_files_activity_media_item_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/shape_music_cover" />

        <RelativeLayout
            android:id="@+id/conversation_files_activity_media_item_duration_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@+id/conversation_files_activity_media_item_image_view"
            android:layout_alignBottom="@+id/conversation_files_activity_media_item_image_view">

            <TextView
                android:id="@+id/conversation_files_activity_media_item_duration_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/conversation_files_activity_media_item_selected_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignEnd="@+id/conversation_files_activity_media_item_image_view"
            android:layout_alignBottom="@+id/conversation_files_activity_media_item_image_view"
            android:background="@drawable/checkbox_background">

            <ImageView
                android:id="@+id/conversation_files_activity_media_item_selected_image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:cropToPadding="true"
                android:background="@drawable/circle_grey"
                android:src="@drawable/check_mark_grey" />
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>