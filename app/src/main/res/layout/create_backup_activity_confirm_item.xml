<?xml version="1.0" encoding="utf-8"?>
<androidx.percentlayout.widget.PercentRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.percentlayout.widget.PercentRelativeLayout
        android:id="@+id/create_backup_activity_confirm_item_layout_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/circle_grey"
        android:layout_centerVertical="true"
        app:layout_aspectRatio="100%">

        <!-- Image heightPercent is not 100% because we need the circle_grey when it is visible.
             circle_grey has an oval shape and a white background which is required by Android API 16.  -->
        <ImageView
            android:id="@+id/create_backup_activity_confirm_item_selected_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:visibility="gone"
            android:scaleType="fitCenter"
            android:cropToPadding="true"
            android:background="@drawable/circle_grey"
            android:src="@drawable/check_mark_grey"
            app:layout_aspectRatio="100%"
            app:layout_heightPercent="100%" />

    </androidx.percentlayout.widget.PercentRelativeLayout>

    <TextView
        android:id="@+id/create_backup_activity_confirm_item_message_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/create_backup_activity_confirm_item_layout_image"
        android:text="@string/backup_view_confirm_message"/>

</androidx.percentlayout.widget.PercentRelativeLayout>
