<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Use windowSplashScreenAnimatedIcon to add either a drawable or an
             animated drawable. One of these is required. -->

        <item name="windowSplashScreenBackground">@color/skred_color</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen_empty</item>
        <!-- <item name="windowSplashScreenAnimatedIcon">@drawable/launcher</item> -->
        <!-- Required for animated icons -->
        <!-- <item name="windowSplashScreenAnimationDuration">2000</item> -->

        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <!-- Required -->
        <!-- We use the SplashScreenActivity specific theme so that the transition looks smooth. -->
        <item name="postSplashScreenTheme">@style/TwinmeThemeWithNoActionBar</item>

    </style>

</resources>