<?xml version="1.0" encoding="utf-8"?>
<!--
  Full opt-out. Every domain is excluded from every extraction mode.
  Fail-open is the default: a missing section means that mode is fully
  enabled for everything except cache/ and no_backup/. So both sections
  must be present, even though they look redundant next to
  android:allowBackup="false".
-->
<data-extraction-rules>

    <!-- Google Drive Auto Backup -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root"              path="." />
        <exclude domain="file"              path="." />
        <exclude domain="database"          path="." />
        <exclude domain="sharedpref"        path="." />
        <exclude domain="external"          path="." />
        <exclude domain="device_root"       path="." />
        <exclude domain="device_file"       path="." />
        <exclude domain="device_database"   path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>

    <!-- Device-to-device transfer ("copy apps & data" during setup).
         NOT covered by allowBackup="false" on all OEM devices. -->
    <device-transfer>
        <exclude domain="root"              path="." />
        <exclude domain="file"              path="." />
        <exclude domain="database"          path="." />
        <exclude domain="sharedpref"        path="." />
        <exclude domain="external"          path="." />
        <exclude domain="device_root"       path="." />
        <exclude domain="device_file"       path="." />
        <exclude domain="device_database"   path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>

</data-extraction-rules>